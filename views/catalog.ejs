<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Зоомагазин "Пушистик" - Каталог</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <!-- Навигация -->
    <div id="nav-bar"></div>
    <%- include('fragments/nav-bar') %>

        <div class="container">
            <!-- Главный баннер -->
            <div class="hero-section text-center">
                <h1 class="display-4 fw-bold">Всё лучшее для ваших питомцев</h1>
                <p class="lead">Скидки до 30% на сухие корма для собак и кошек!</p>
            </div>

            <!-- Фильтры и сортировка (заглушка) -->
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4>Каталог товаров</h4>
                <select class="form-select w-auto">
                    <option>Сначала популярные</option>
                    <option>Сначала дешевые</option>
                    <option>Сначала дорогие</option>
                </select>
            </div>
            <div id="setka" class="row g-4">
                <% for (let index = 0; index < 10; index++) { %>
                    <%- include('fragments/card', {product:json_products[index]}) %>
                <% } %>
            </div>
          
        </div>

        <!-- Подвал -->
        <div id="footer"></div>
        <%- include('fragments/footer') %>

            <!-- Bootstrap JS -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

            <!-- <script src="js/elements.js"></script> -->


</body>

</html>