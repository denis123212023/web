<div class="col-12 col-md-6 col-lg-3">
    <div class="card product-card h-100">

        <img id="src" src="<%= product.img_src %>"
             class="card-img-top" alt="<%= product.card_name %>">

        <div class="card-body d-flex flex-column">

            <h5 id="name_on_card" class="card-title"><%= product.name_on_card %></h5>

            <p id="small_desc" class="card-text text-muted small">
                <%= product.small_desc %>
            </p>

            <div class="mt-auto">
                <p id="price" class="price mb-2"><%= product.price %></p>
                <button type="button" class="btn btn-primary w-100" onclick="window.location.href='/product/<%= product.id %>'"" >Подробнее</button>
            </div>

        </div>
    </div>
</div>
